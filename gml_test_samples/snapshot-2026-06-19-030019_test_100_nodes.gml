    outbox "https://vmst.io/users/s_chaussee/outbox"
    summary "<p><a href=&amp;#34;https://vmst.io/tags/MarineArchaeologist&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>MarineArchaeologist</span></a> | <a href=&amp;#34;https://vmst.io/tags/PhD&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>PhD</span></a> Roman and early medieval <a href=&amp;#34;https://vmst.io/tags/LandscapeArchaeology&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>LandscapeArchaeology</span></a> | Subaerial/submerged landscapes | <a href=&amp;#34;https://vmst.io/tags/UAS&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>UAS</span></a> for archaeology | <a href=&amp;#34;https://vmst.io/tags/RStats&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>RStats</span></a> |#LifelongLearning tutor Aberystwyth University |  | Born Jayhawk <a href=&amp;#34;https://vmst.io/tags/LFK&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>LFK</span></a> | &amp;#26085;&amp;#26412;&amp;#35486;&amp;#12434;&amp;#21193;&amp;#24375;&amp;#12375;&amp;#12390;&amp;#12356;&amp;#12427; | Prospect Union | I stand with refugees. Ad Astra Per Aspera</p>"
    properties "[[&amp;#34;Pronouns&amp;#34;, &amp;#34;He/Him/His&amp;#34;], [&amp;#34;Archaeology business:&amp;#34;, &amp;#34;<a href=\&amp;#34;https://www.geotechne.com\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://www.</span><span class=\&amp;#34;\&amp;#34;>geotechne.com</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;Professional details:&amp;#34;, &amp;#34;<a href=\&amp;#34;https://www.linkedin.com/in/schaussee/\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://www.</span><span class=\&amp;#34;\&amp;#34;>linkedin.com/in/schaussee/</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;Current project:&amp;#34;, &amp;#34;<a href=\&amp;#34;https://fujiarchlakescapes.hcommons.org/\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;ellipsis\&amp;#34;>fujiarchlakescapes.hcommons.or</span><span class=\&amp;#34;invisible\&amp;#34;>g/</span></a>&amp;#34;]]"
