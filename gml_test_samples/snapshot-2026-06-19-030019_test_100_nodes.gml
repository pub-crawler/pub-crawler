    outbox "https://waldvogel.family/users/marcel/outbox"
    summary "<p>Aus 4 Jahrzehnten Fehlern gelernt, versuche ich Technik einzuordnen, sicher zu machen und menschlich zu erkl&amp;#228;ren.</p><p><a href=&amp;#34;https://waldvogel.family/tags/Erkl%C3%A4rb%C3%A4r&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Erkl&amp;#228;rb&amp;#228;r</span></a> bei <a href=&amp;#34;https://waldvogel.family/tags/DNIP&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>DNIP</span></a>, im Vorstand der <span class=&amp;#34;h-card&amp;#34; translate=&amp;#34;no&amp;#34;><a href=&amp;#34;https://mastodon.social/@digiges&amp;#34; class=&amp;#34;u-url mention&amp;#34;>@<span>digiges</span></a></span>, macht IT-Security bei einem Schweizer Grossunternehmen. Hier aber sowas von privat.<br /><a href=&amp;#34;https://waldvogel.family/tags/Speaker&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Speaker</span></a> <a href=&amp;#34;https://waldvogel.family/tags/Security&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Security</span></a> <a href=&amp;#34;https://waldvogel.family/tags/Privacy&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Privacy</span></a> <a href=&amp;#34;https://waldvogel.family/tags/Cloud&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Cloud</span></a></p><p>Posts verfallen nach 1 Monat. Searchable.</p>"
    properties "[[&amp;#34;Tech (E)&amp;#34;, &amp;#34;<a href=\&amp;#34;https://netfuture.ch\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>netfuture.ch</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;Gesellschaft (D)&amp;#34;, &amp;#34;<a href=\&amp;#34;https://marcel-waldvogel.ch/\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>marcel-waldvogel.ch/</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;DNIP (Erkl\u00e4rb\u00e4r)&amp;#34;, &amp;#34;<a href=\&amp;#34;https://dnip.ch\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>dnip.ch</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;Digiges (Vorstand)&amp;#34;, &amp;#34;<a href=\&amp;#34;https://www.digitale-gesellschaft.ch/uber-uns/kurzvorstellung-personen/\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://www.</span><span class=\&amp;#34;ellipsis\&amp;#34;>digitale-gesellschaft.ch/uber-</span><span class=\&amp;#34;invisible\&amp;#34;>uns/kurzvorstellung-personen/</span></a>&amp;#34;]]"
