    hostname "mastodon.social"
    memorial 0
    followers "https://mastodon.social/users/mcnees/followers"
    following "https://mastodon.social/users/mcnees/following"
    indexable 1
    published "2016-11-21T00:00:00Z"
    httpstatus 200
    discoverable 1
    lastfetchdate "2026-06-15T03:56:41.492068+00:00"
    preferredusername "mcnees"
    icon "https://files.mastodon.social/accounts/avatars/000/010/908/original/a92bd0fffe57a93f.jpeg"
    name "Robert McNees"
    image "https://files.mastodon.social/accounts/headers/000/010/908/original/5a9dab32db75c216.jpeg"
    outbox "https://mastodon.social/users/mcnees/outbox"
    summary "<p>Physicist and professor at a school on the north side of Chicago. Black holes, quantum gravity, cosmology. Rocky Top, Tar Heel. Science, dogs, lake photos. Faves are spooky action at a distance, boosts are Lorentz transformations to another inertial frame. Opinions are mine, not my employer&amp;#8217;s.&amp;#8233;<a href=&amp;#34;https://mastodon.social/tags/Physics&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Physics</span></a> <a href=&amp;#34;https://mastodon.social/tags/BlackHoles&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>BlackHoles</span></a> <a href=&amp;#34;https://mastodon.social/tags/Gravity&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Gravity</span></a> <a href=&amp;#34;https://mastodon.social/tags/SciComm&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>SciComm</span></a> <a href=&amp;#34;https://mastodon.social/tags/Dogs&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Dogs</span></a></p><p>Level 14 Prof of Physics, Neutral Good, S:11 I:16 W:15 D:11 C:12 Ch:11, HP: 68, THAC0: 11, Equipment: Vorpal Chalk, Periapt of Tenure, Tweed Jacket (Cursed)</p>"
    properties "[[&amp;#34;Web&amp;#34;, &amp;#34;<a href=\&amp;#34;https://jacobi.luc.edu/index.html\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>jacobi.luc.edu/index.html</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;Bluesky&amp;#34;, &amp;#34;<a href=\&amp;#34;https://bsky.app/profile/mcnees.bsky.social\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;ellipsis\&amp;#34;>bsky.app/profile/mcnees.bsky.s</span><span class=\&amp;#34;invisible\&amp;#34;>ocial</span></a>&amp;#34;], [&amp;#34;Google Scholar&amp;#34;, &amp;#34;<a href=\&amp;#34;https://scholar.google.com/citations?user=Xv-faY4AAAAJ&amp;#38;amp;hl=en&amp;#38;amp;oi=ao\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;ellipsis\&amp;#34;>scholar.google.com/citations?u</span><span class=\&amp;#34;invisible\&amp;#34;>ser=Xv-faY4AAAAJ&amp;#38;amp;hl=en&amp;#38;amp;oi=ao</span></a>&amp;#34;], [&amp;#34;mcnees.github.io&amp;#34;, &amp;#34;<a href=\&amp;#34;https://mcnees.github.io/about/\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>mcnees.github.io/about/</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;]]"
