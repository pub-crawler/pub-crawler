    indexable 1
    published "2022-05-03T00:00:00Z"
    httpstatus 200
    discoverable 1
    lastfetchdate "2026-06-15T03:25:50.487168+00:00"
    preferredusername "yrochat"
    icon "https://media.mathstodon.xyz/accounts/avatars/108/238/671/341/826/201/original/6f122b7eaee15046.jpg"
    name "Yannick Rochat"
    image "https://media.mathstodon.xyz/accounts/headers/108/238/671/341/826/201/original/db814caece274dc5.jpg"
    outbox "https://mathstodon.xyz/users/yrochat/outbox"
    summary "<p>Assistant Professor in Game Studies at the Faculty of Arts (<a href=&amp;#34;https://mathstodon.xyz/tags/LettresUNIL&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>LettresUNIL</span></a>) of the University of Lausanne, Switzerland (<a href=&amp;#34;https://mathstodon.xyz/tags/UNIL&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>UNIL</span></a>).</p><p>Game studies group <span class=&amp;#34;h-card&amp;#34; translate=&amp;#34;no&amp;#34;><a href=&amp;#34;https://hcommons.social/@gamelabunilepfl&amp;#34; class=&amp;#34;u-url mention&amp;#34;>@<span>gamelabunilepfl</span></a></span></p><p>Research project on the video games created in Switzerland in the 20th Century <span class=&amp;#34;h-card&amp;#34; translate=&amp;#34;no&amp;#34;><a href=&amp;#34;https://hcommons.social/@chludens&amp;#34; class=&amp;#34;u-url mention&amp;#34;>@<span>chludens</span></a></span></p><p><a href=&amp;#34;https://mathstodon.xyz/tags/GameStudies&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>GameStudies</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/SciencesDuJeu&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>SciencesDuJeu</span></a> <a href=&amp;#34;https://mathstodon.xyz/tags/DigitalHumanities&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>DigitalHumanities</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/Mathematics&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Mathematics</span></a> <a href=&amp;#34;https://mathstodon.xyz/tags/SwissGames&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>SwissGames</span></a></p><p>&amp;#128694;&amp;#128690; &amp;#128654; &amp;#128651; &amp;#128642; </p><p>He/him</p><p>Header: 5 Centimeters per Second (Shinkai, 2007)</p>"
    properties "[[&amp;#34;Website (en-fr)&amp;#34;, &amp;#34;<a href=\&amp;#34;https://yro.ch\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>yro.ch</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;GameLab (fr)&amp;#34;, &amp;#34;<a href=\&amp;#34;https://gamelab-lausanne.ch/\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>gamelab-lausanne.ch/</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;Pixelfed&amp;#34;, &amp;#34;<a href=\&amp;#34;https://pixelfed.social/yrochat\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>pixelfed.social/yrochat</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;Places&amp;#34;, &amp;#34;Lausanne &amp;#38;amp; Biel/Bienne, Switzerland&amp;#34;]]"
