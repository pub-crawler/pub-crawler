    icon "https://media.mathstodon.xyz/accounts/avatars/109/308/634/839/560/464/original/e733b7f89ae29c44.png"
    name "Dan Drake &amp;#129414;"
    image ""
    outbox "https://mathstodon.xyz/users/ddrake/outbox"
    summary "<p>Former <a href=&amp;#34;https://mathstodon.xyz/tags/softwareengineer&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>softwareengineer</span></a>, current <a href=&amp;#34;https://mathstodon.xyz/tags/mathematician&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>mathematician</span></a>, college <a href=&amp;#34;https://mathstodon.xyz/tags/math&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>math</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/computerscience&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>computerscience</span></a> and <a href=&amp;#34;https://mathstodon.xyz/tags/datascience&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>datascience</span></a> lecturer in <a href=&amp;#34;https://mathstodon.xyz/tags/stpaulmn&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>stpaulmn</span></a> <a href=&amp;#34;https://mathstodon.xyz/tags/Minnesota&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Minnesota</span></a> at <a href=&amp;#34;https://mathstodon.xyz/tags/Macalester&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Macalester</span></a> College. (And, starting fall 2026, Saint Olaf College in Northfield, MN.) I&amp;#38;#39;m searchable on tootfinder.</p><p>Here, have a hashtag-y list of things I&amp;#38;#39;m interested in (no particular order):</p><p><a href=&amp;#34;https://mathstodon.xyz/tags/math&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>math</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/geometry&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>geometry</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/origami&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>origami</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/crochet&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>crochet</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/Linux&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Linux</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/emacs&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>emacs</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/bicycling&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>bicycling</span></a>, going <a href=&amp;#34;https://mathstodon.xyz/tags/hiking&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>hiking</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/sciencefiction&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>sciencefiction</span></a>, <a href=&amp;#34;https://mathstodon.xyz/tags/science&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>science</span></a> fact, <a href=&amp;#34;https://mathstodon.xyz/tags/mtbos&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>mtbos</span></a> <a href=&amp;#34;https://mathstodon.xyz/tags/csed&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>csed</span></a></p>"
    properties "[[&amp;#34;blog-ish&amp;#34;, &amp;#34;<a href=\&amp;#34;https://ddrake.prose.sh\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>ddrake.prose.sh</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;linkedin&amp;#34;, &amp;#34;<a href=\&amp;#34;https://www.linkedin.com/in/ddrake2/\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://www.</span><span class=\&amp;#34;\&amp;#34;>linkedin.com/in/ddrake2/</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;website&amp;#34;, &amp;#34;<a href=\&amp;#34;https://dandrake.github.io\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>dandrake.github.io</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;]]"
