    icon "https://cdn.fosstodon.org/accounts/avatars/109/364/675/131/123/082/original/787d148ea451ba10.jpg"
    name "Tomasz Wo&amp;#378;niak"
    image "https://cdn.fosstodon.org/accounts/headers/109/364/675/131/123/082/original/fc782fa89c351146.png"
    outbox "https://fosstodon.org/users/tomaszwozniak/outbox"
    summary "<p>I&amp;#38;#39;m a Bayesian econometrician developing methodology for empirical macroeconomic analyses and programming in &amp;#120293; and &amp;#120304;&amp;#120317;&amp;#120317; using &amp;#120293;&amp;#120304;&amp;#120317;&amp;#120317;. &amp;#8232;I developed &amp;#120293; packages &amp;#120303;&amp;#120320;&amp;#120323;&amp;#120302;&amp;#120319;&amp;#120320; and &amp;#120303;&amp;#120320;&amp;#120323;&amp;#120302;&amp;#120319;&amp;#120294;&amp;#120284;&amp;#120282;&amp;#120289;&amp;#120320;! <span class=&amp;#34;h-card&amp;#34; translate=&amp;#34;no&amp;#34;><a href=&amp;#34;https://fosstodon.org/@bsvars&amp;#34; class=&amp;#34;u-url mention&amp;#34;>@<span>bsvars</span></a></span> &amp;#8232;&amp;#8232;<a href=&amp;#34;https://bsvars.org&amp;#34; target=&amp;#34;_blank&amp;#34; rel=&amp;#34;nofollow noopener&amp;#34; translate=&amp;#34;no&amp;#34;><span class=&amp;#34;invisible&amp;#34;>https://</span><span class=&amp;#34;&amp;#34;>bsvars.org</span><span class=&amp;#34;invisible&amp;#34;></span></a>&amp;#8232;:rstats: :cpp_language: :git: :github:&amp;#8233;&amp;#8232;<a href=&amp;#34;https://fosstodon.org/tags/Bayesian&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>Bayesian</span></a> <a href=&amp;#34;https://fosstodon.org/tags/timeseries&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>timeseries</span></a> <a href=&amp;#34;https://fosstodon.org/tags/econometrics&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>econometrics</span></a> <a href=&amp;#34;https://fosstodon.org/tags/bsvars&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>bsvars</span></a> <a href=&amp;#34;https://fosstodon.org/tags/bsvarSIGNs&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>bsvarSIGNs</span></a> <a href=&amp;#34;https://fosstodon.org/tags/rstats&amp;#34; class=&amp;#34;mention hashtag&amp;#34; rel=&amp;#34;tag&amp;#34;>#<span>rstats</span></a></p>"
    properties "[[&amp;#34;profile&amp;#34;, &amp;#34;<a href=\&amp;#34;https://github.com/donotdespair\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>github.com/donotdespair</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;bsvars&amp;#34;, &amp;#34;<a href=\&amp;#34;https://bsvars.org/\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;\&amp;#34;>bsvars.org/</span><span class=\&amp;#34;invisible\&amp;#34;></span></a>&amp;#34;], [&amp;#34;bsvars on CRAN&amp;#34;, &amp;#34;<a href=\&amp;#34;https://cran.r-project.org/package=bsvars\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;ellipsis\&amp;#34;>cran.r-project.org/package=bsv</span><span class=\&amp;#34;invisible\&amp;#34;>ars</span></a>&amp;#34;], [&amp;#34;bsvarSIGNs on CRAN&amp;#34;, &amp;#34;<a href=\&amp;#34;https://cran.r-project.org/package=bsvarSIGNs\&amp;#34; target=\&amp;#34;_blank\&amp;#34; rel=\&amp;#34;nofollow noopener me\&amp;#34; translate=\&amp;#34;no\&amp;#34;><span class=\&amp;#34;invisible\&amp;#34;>https://</span><span class=\&amp;#34;ellipsis\&amp;#34;>cran.r-project.org/package=bsv</span><span class=\&amp;#34;invisible\&amp;#34;>arSIGNs</span></a>&amp;#34;]]"
